{
  "name": "wxt-toolbox",
  "description": "Extension modular con miles de herramientas (WXT + TypeScript + React)",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tool:new": "node scripts/new-tool.mjs",
    "tool:list": "node scripts/list-tools.mjs",
    "postinstall": "wxt prepare",
    "native:build": "node scripts/build-native.mjs",
    "native:build:wasm": "node scripts/build-native.mjs --wasm",
    "native:test": "node scripts/test-native.mjs",
    "native:install": "node scripts/install-native.mjs",
    "safari:convert": "node scripts/safari-convert.mjs",
    "check": "pnpm compile && pnpm lint && pnpm test && pnpm native:test"
  },
  "dependencies": {
    "@webext-core/messaging": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "wxt": "^0.21.5"
  }
}
